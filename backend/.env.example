# 複製成 .env（已在 .gitignore）。沒有 key 也能跑：Copilot 退回規則式分析、VLM 退回模擬感知。
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini            # Copilot 用
OPENAI_VISION_MODEL=gpt-4o-mini     # VLM 用（需支援影像）
# OPENAI_BASE_URL=                  # 相容端點（Azure / 本機 proxy）可填
TWIN_VLM_ACTS=0                     # 1 = VLM 偵測到人就真的封鎖 Zone（會干擾模擬，Demo 03 想全自動時開）
TWIN_SEED=42

# ── 公開部署防護（本機開發可全部不設）──
# TWIN_CORS_ORIGINS=https://ware-twin.vercel.app   # 逗號分隔；設了之後 WebSocket 與 POST 都要帶允許的 Origin
# TWIN_CORS_REGEX=https://ware-twin-[a-z0-9]+-<scope-slug>\.vercel\.app   # 正式部署不設；要開 Vercel preview 時才加，且要鎖自己的 scope slug
# TWIN_TRUSTED_PROXIES=1                          # 取 X-Forwarded-For 倒數第 N 段當 client IP（Render=1；本機直連設 0）
# TWIN_ALLOW_NO_ORIGIN=0                           # 1 = 允許沒有 Origin 的請求（curl / 腳本）
# TWIN_RATE_LIMIT=1                                # 0 = 關閉 rate limit（每 IP：mutate 20/min、ai 10/min、what-if 4/min）
# TWIN_HEALTH_STALL_S=10                           # 模擬超過幾秒沒推進就讓 /api/health 回 503

# ── MQTT → Eclipse Ditto（tùy chọn）──
# Bật để đẩy trạng thái hiện tại của robot/conveyor/... sang Ditto qua MQTT (chỉ gửi phần thay đổi).
# Setup policy + connection: backend/infra/ditto/provision.sh
# TWIN_MQTT_ENABLED=1
# TWIN_MQTT_URL=mqtt://localhost:1883              # backend chạy ngoài docker; trong docker dùng tcp://mosquitto:1883
# TWIN_MQTT_NAMESPACE=waretwin
# TWIN_MQTT_POLICY_ID=waretwin:waretwin-policy
# TWIN_MQTT_INTERVAL_S=0.5                          # coalesce: không publish mỗi tick
# TWIN_MQTT_QOS=1
# TWIN_MQTT_USERNAME=
# TWIN_MQTT_PASSWORD=

# External allocator (internal remains the default).
# TWIN_ALLOCATION_MODE=external
# FLEET_API_KEY=                         # same secret in task_allocator; required in external mode
# TWIN_DISPATCH_SNAPSHOT=1               # publish dispatch in internal mode for --shadow
