{
  "policyId": "waretwin:waretwin-policy",
  "entries": {
    "DEFAULT": {
      "subjects": {
        "nginx:ditto": {
          "type": "basic auth user"
        }
      },
      "resources": {
        "thing:/": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "policy:/": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        },
        "message:/": {
          "grant": ["READ", "WRITE"],
          "revoke": []
        }
      },
      "importable": "implicit"
    }
  }
}
